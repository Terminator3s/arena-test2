<Window x:Class="JoistCalculator.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JoistCalculator.UI.ViewModels"
        mc:Ignorable="d"
        Title="نرم‌افزار محاسبات و طراحی تیرچه بتنی (بر اساس مبحث ۹ مقررات ملی و ACI 209)" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#007ACC" Padding="15" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="سامانه جامع محاسبات و طراحی تیرچه بتنی (مبحث ۹ مقررات ملی ساختمان - ویرایش ۱۳۹۹)" 
                           Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="تحلیل خیز، خزش، افت بتن، برش، خمش و لرزش سقف تیرچه بلوک" 
                           Foreground="#E0F7FA" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content (Inputs & Results) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs Section (Left / Right in RTL) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,5,0">
                <StackPanel>
                    <!-- Material Properties -->
                    <GroupBox Header="مشخصات مصالح">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="مقاومت فشاری مشخصه بتن (f'c)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.Fc, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="MPa" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="تنش تسلیم میلگرد طولی تیرچه (fy)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.Fy, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="MPa" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="تنش تسلیم میلگرد عرضی (fyt)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.Fyt, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="MPa" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Geometry -->
                    <GroupBox Header="ابعاد و هندسه مقطع">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="طول دهانه تیرچه (L)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.SpanLength, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="m" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ارتفاع کل تیرچه (h)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.TotalHeight, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ضخامت دال بتنی رویه (t)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.SlabThickness, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="فاصله خالص تیرچه‌ها (S)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.JoistSpacing, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="عرض تک تیرچه (W)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.RibWidth, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="نوع تیرچه (D: دوبل، S: تک)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.JoistType, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="-" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Loads -->
                    <GroupBox Header="بارگذاری">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="بار زنده (Live Load)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.LiveLoad, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="kPa" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="بار مرده تیغه‌بندی (Partition)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.PartitionLoad, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="kPa" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="بار مرده کف‌سازی (Super Dead)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.SuperDeadLoad, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="kPa" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="بار زنده متمرکز (Point load)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Input.PointLoad, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="kN" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Results Section (Right / Left in RTL) -->
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <TabItem Header="نتایج محاسباتی">
                        <DataGrid ItemsSource="{Binding ResultItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="پارامتر / نتیجه" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="مقدار" Binding="{Binding Value}" Width="90"/>
                                <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="کنترل‌های سازه‌ای">
                        <DataGrid ItemsSource="{Binding StatusItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="کنترل / ضابطه" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Value}" Width="100"/>
                                <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="محاسبه نتایج" Command="{Binding CalculateCommand}" Width="150" Height="40" Margin="5" FontSize="14"/>
                    <Button Content="ذخیره / خروجی اکسل" Command="{Binding ExportExcelCommand}" Width="150" Height="40" Margin="5" FontSize="14" Background="#28A745"/>
                </StackPanel>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#E0E0E0" Padding="8" CornerRadius="4">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Foreground="#333333"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
